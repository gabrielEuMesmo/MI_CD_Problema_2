module RegShift8bits(E, Q, CK, D, Enable);

	input [7:0]D;
	output [7:0]Q;
	input CK, Enable, E;
	
	wire [8:0]T;
	
	DFlipFlop(T[0], CK, Q[0],);
	DFlipFlop(T[1], CK, Q[1],);
	DFlipFlop(T[2], CK, Q[2],);
	DFlipFlop(T[3], CK, Q[3],);
	DFlipFlop(T[4], CK, Q[4],);
	DFlipFlop(T[5], CK, Q[5],);
	DFlipFlop(T[6], CK, Q[6],);
	DFlipFlop(T[7], CK, Q[7],);
	
	mux1(Q[1], D[0], Enable, T[0]);
	mux1(Q[2], D[1], Enable, T[1]);
	mux1(Q[3], D[2], Enable, T[2]);
	mux1(Q[4], D[3], Enable, T[3]);
	mux1(Q[5], D[4], Enable, T[4]);
	mux1(Q[6], D[5], Enable, T[5]);
	mux1(Q[7], D[6], Enable, T[6]);
	mux1(E, D[7], Enable, T[7]);
endmodule